# Copy to .env (git-ignored) or set these as Cloud Agent secrets.
# Only the provider(s) you actually run need a key.

# --- Cursor (default model: cursor-grok-4.6) ---------------------------------
# NOTE: Cursor does not (yet) publish a standalone OpenAI-compatible
# chat-completions endpoint; its API key officially drives the Cloud Agents API.
# This provider speaks the OpenAI chat-completions wire format against
# CURSOR_API_BASE, so point it at an OpenAI-compatible gateway keyed by your
# Cursor key, or at the official endpoint if/when it ships.
CURSOR_API_KEY=
# CURSOR_API_BASE=https://api.cursor.com/v1
# CURSOR_JSON_MODE=1

# --- Google Gemini ----------------------------------------------------------
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
